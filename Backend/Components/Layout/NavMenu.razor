@using ANpay.Api.Components.Services
@inject AuthState Auth
@inject NavigationManager Nav

<div class="logo">
    AN<span>pay</span>
</div>

@if (Auth.IsLoggedIn)
{
    <nav class="nav-menu">
        @if (Auth.IsSuperAdmin())
        {
            <a href="/admin/dashboard" class="nav-item @(Nav.Uri.Contains("/admin/dashboard") ? "active" : "")">
                Dashboard
            </a>
            <a href="/admin/users" class="nav-item @(Nav.Uri.Contains("/admin/users") ? "active" : "")">
                Users
            </a>
            <a href="/admin/branches" class="nav-item @(Nav.Uri.Contains("/admin/branches") ? "active" : "")">
                Branches
            </a>
            <a href="/admin/transactions" class="nav-item @(Nav.Uri.Contains("/admin/transactions") ? "active" : "")">
                Transactions
            </a>
            <a href="/admin/approvals" class="nav-item @(Nav.Uri.Contains("/admin/approvals") ? "active" : "")">
                Approvals
            </a>
            <a href="/admin/kyc" class="nav-item @(Nav.Uri.Contains("/admin/kyc") ? "active" : "")">
                KYC
            </a>
            <a href="/admin/settings" class="nav-item @(Nav.Uri.Contains("/admin/settings") ? "active" : "")">
                Settings
            </a>
        }
        else if (Auth.IsBranchAdmin())
        {
            <a href="/branch/dashboard" class="nav-item @(Nav.Uri.Contains("/branch/dashboard") ? "active" : "")">
                Dashboard
            </a>
            <a href="/branch/officials" class="nav-item @(Nav.Uri.Contains("/branch/officials") ? "active" : "")">
                Officials
            </a>
            <a href="/branch/reports" class="nav-item @(Nav.Uri.Contains("/branch/reports") ? "active" : "")">
                Reports
            </a>
        }
        else if (Auth.IsOfficial())
        {
            <a href="/official/dashboard" class="nav-item @(Nav.Uri.Contains("/official/dashboard") ? "active" : "")">
                Dashboard
            </a>
            <a href="/official/transactions" class="nav-item @(Nav.Uri.Contains("/official/transactions") ? "active" : "")">
                Process Transactions
            </a>
        }
        else
        {
            <a href="/customer/dashboard" class="nav-item @(Nav.Uri.Contains("/customer/dashboard") ? "active" : "")">
                Dashboard
            </a>
            <a href="/customer/profile" class="nav-item @(Nav.Uri.Contains("/customer/profile") ? "active" : "")">
                Profile
            </a>
        }

        <div style="border-top: 1px solid var(--border-color); margin-top: auto; padding-top: 12px;">
            <a href="/" class="nav-item">
                Home
            </a>
            <div style="padding: 8px 16px; display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 14px;">@Auth.GetDisplayName()</span>
                <button class="btn btn-sm btn-outline" @onclick="Logout" style="margin-left: auto;">Logout</button>
            </div>
        </div>
    </nav>
}
else
{
    <nav class="nav-menu">
        <a href="/" class="nav-item @(Nav.Uri == "/" || Nav.Uri.EndsWith("/") ? "active" : "")">
            Home
        </a>
        <a href="/login" class="nav-item @(Nav.Uri.Contains("/login") ? "active" : "")">
            Sign In
        </a>
        <a href="/register" class="nav-item @(Nav.Uri.Contains("/register") ? "active" : "")">
            Register
        </a>
    </nav>
}

@code {
    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
