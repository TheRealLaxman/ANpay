@page "/official/transactions"
@rendermode InteractiveServer
@using ANpay.Api.Components.Services
@inject AuthState Auth
@inject NavigationManager Nav

@if (!Auth.IsLoggedIn || !Auth.IsOfficial())
{
    Nav.NavigateTo("/login");
    return;
}

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1>Process Transactions</h1>
            <p>Review and process pending transactions</p>
        </div>
        <div class="header-right">
            <a href="/official/dashboard" class="btn btn-outline">Back</a>
        </div>
    </div>

    <div class="card">
        <p style="color: var(--text-secondary);">Transaction processing APIs are ready.</p>
        <p style="color: var(--text-secondary); font-size: 14px; margin-top: 8px;">Available APIs:</p>
        <ul style="color: var(--text-secondary); font-size: 14px; margin-left: 20px;">
            <li>POST /api/wallet/deposit - Process deposit</li>
            <li>POST /api/wallet/withdraw - Process withdrawal</li>
            <li>POST /api/wallet/transfer - Process transfer</li>
            <li>GET /api/approval/pending - View pending approvals</li>
        </ul>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsLoggedIn || !Auth.IsOfficial())
            Nav.NavigateTo("/login");
    }
}
