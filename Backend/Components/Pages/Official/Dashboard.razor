@page "/official/dashboard"
@rendermode InteractiveServer
@using ANpay.Api.Components.Services
@inject AuthState Auth
@inject ApiService Api
@inject NavigationManager Nav

@if (!Auth.IsLoggedIn || !Auth.IsOfficial())
{
    Nav.NavigateTo("/login");
    return;
}

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1>Official Dashboard</h1>
            <p>Welcome, @Auth.GetDisplayName()</p>
        </div>
        <div class="header-right">
            <span class="badge badge-info">Official</span>
            <button class="btn btn-outline" @onclick="Logout">Logout</button>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <div class="card">
            <h3 style="font-size: 16px; margin-bottom: 16px;">Quick Actions</h3>
            <div class="quick-actions">
                <a href="/official/transactions" class="btn btn-primary">Process Transactions</a>
            </div>
        </div>

        <div class="card">
            <h3 style="font-size: 16px; margin-bottom: 16px;">Your Role</h3>
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: var(--text-secondary);">Name</span>
                    <span>@Auth.GetDisplayName()</span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: var(--text-secondary);">Role</span>
                    <span>Branch Employee</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsLoggedIn || !Auth.IsOfficial())
        {
            Nav.NavigateTo("/login");
            return;
        }
        Api.SetToken(Auth.Token);
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
