@page "/customer/pos"
@using ANpay.Api.Models
@using ANpay.Api.Components.Services
@inject ApiService ApiService
@inject AuthState AuthState
@rendermode InteractiveServer

<PageTitle>POS Terminal - ANpay</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-upc-scan me-2"></i>POS Terminal</h2>
            <p class="text-muted">Accept payments via POS devices and Tap-to-Pay.</p>
        </div>
    </div>

    @if (devices != null && devices.Any())
    {
        <div class="row mb-4">
            @foreach (var device in devices)
            {
                <div class="col-md-4 mb-3">
                    <div class="card @(device.Status == PosDeviceStatus.Active ? "border-success" : "border-secondary")">
                        <div class="card-body">
                            <h5>@device.DeviceModel</h5>
                            <p class="text-muted">S/N: @device.DeviceSerial</p>
                            <div class="mb-2">
                                <span class="badge @(device.Status == PosDeviceStatus.Active ? "bg-success" : "bg-secondary")">@device.Status</span>
                            </div>
                            <div class="small">
                                <div>NFC: @(device.SupportsNfc ? "Yes" : "No")</div>
                                <div>Chip: @(device.SupportsChip ? "Yes" : "No")</div>
                                <div>Tap-to-Pay: @(device.SupportsTapToPay ? "Yes" : "No")</div>
                            </div>
                        </div>
                        <div class="card-footer">
                            @if (device.Status != PosDeviceStatus.Active)
                            {
                                <button class="btn btn-success btn-sm w-100" @onclick="() => ActivateDevice(device.Id)">Activate</button>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-sm w-100" @onclick="() => ShowSaleModal(device)">Process Sale</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (transactions != null && transactions.Any())
    {
        <h4>Recent Transactions</h4>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead><tr><th>Date</th><th>Device</th><th>Amount</th><th>Fee</th><th>Status</th><th>Reference</th></tr></thead>
                <tbody>
                    @foreach (var tx in transactions.Take(10))
                    {
                        <tr>
                            <td>@tx.CreatedAt.ToString("MMM dd HH:mm")</td>
                            <td>@tx.PosDeviceId.ToString()[..8]</td>
                            <td>₦@tx.Amount.ToString("N2")</td>
                            <td>₦@tx.Fee.ToString("N2")</td>
                            <td><span class="badge @(tx.Status == PosTransactionStatus.Completed ? "bg-success" : "bg-secondary")">@tx.Status</span></td>
                            <td><code>@tx.ReferenceNumber</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<PosDevice>? devices;
    private List<PosTransaction>? transactions;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn) return;
    }

    private async Task ActivateDevice(Guid id)
    {
        try
        {
            await ApiService.PostAsync<PosDevice>($"/api/pos/devices/{id}/activate?merchantId=00000000-0000-0000-0000-000000000000", null);
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    private void ShowSaleModal(PosDevice device) { }
}