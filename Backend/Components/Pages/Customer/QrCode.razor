@page "/customer/qr"
@rendermode InteractiveServer
@using ANpay.Api.Components.Services
@inject ApiService Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page-container">
    <header class="page-header">
        <div class="header-left">
            <h1>QR Codes</h1>
        </div>
        <div class="header-right">
            <a href="/customer/dashboard" class="btn btn-outline">Dashboard</a>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert alert-@(alertSuccess ? "success" : "danger")">@alertMessage</div>
    }

    <div class="grid grid-2">
        <div class="card">
            <div class="card-header">Generate QR Code</div>
            <div class="form-group">
                <label class="form-label">Type</label>
                <select class="form-control" @bind="generateType">
                    <option value="CustomerPay">Customer Pay</option>
                    <option value="MerchantPayment">Merchant Payment</option>
                    <option value="BranchDeposit">Branch Deposit</option>
                    <option value="WalletAddress">Wallet Address</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Amount (optional)</label>
                <input class="form-control" type="number" step="0.01" @bind="generateAmount" placeholder="0.00" />
            </div>
            <div class="form-group">
                <label class="form-label">Description</label>
                <input class="form-control" @bind="generateDescription" placeholder="e.g. Coffee payment" />
            </div>
            <button class="btn btn-primary" @onclick="HandleGenerate" disabled="@generating">
                @(generating ? "Generating..." : "Generate QR")
            </button>

            @if (generatedQr != null)
            {
                <div style="margin-top:20px; padding:16px; background:var(--bg-secondary); border-radius:8px; border:1px solid var(--border-color);">
                    <div style="font-size:12px; color:var(--text-secondary); margin-bottom:8px;">QR Code Generated</div>
                    <div style="font-family:monospace; font-size:14px; word-break:break-all; padding:12px; background:var(--bg-primary); border-radius:6px; border:1px solid var(--border-color); margin-bottom:12px;">
                        @generatedQr.Code
                    </div>
                    <div style="display:flex; gap:8px;">
                        <button class="btn btn-outline" @onclick="CopyQrCode">Copy Code</button>
                        <button class="btn btn-outline" @onclick="ClearGenerated">Clear</button>
                    </div>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">Scan QR Code</div>
            <div class="form-group">
                <label class="form-label">Paste or enter QR code</label>
                <textarea class="form-control" rows="3" @bind="scanInput" placeholder="Paste QR code string here..."></textarea>
            </div>
            <button class="btn btn-primary" @onclick="HandleScan" disabled="@(scanning || string.IsNullOrWhiteSpace(scanInput))">
                @(scanning ? "Scanning..." : "Scan QR")
            </button>

            @if (scanResult != null)
            {
                <div style="margin-top:20px; padding:16px; background:var(--bg-secondary); border-radius:8px; border:1px solid var(--border-color);">
                    <div style="font-size:12px; color:var(--text-secondary); margin-bottom:12px;">Scan Result</div>

                    @if (!scanResult.IsValid)
                    {
                        <div style="color:var(--color-danger); font-size:14px;">@scanResult.Message</div>
                    }
                    else
                    {
                        <div style="display:flex; flex-direction:column; gap:10px; font-size:14px;">
                            <div style="display:flex; justify-content:space-between;">
                                <span style="color:var(--text-secondary);">Type</span>
                                <span style="font-weight:500;">@scanResult.Type</span>
                            </div>
                            <div style="display:flex; justify-content:space-between;">
                                <span style="color:var(--text-secondary);">Creator</span>
                                <span style="font-weight:500;">@scanResult.CreatorName</span>
                            </div>
                            <div style="display:flex; justify-content:space-between;">
                                <span style="color:var(--text-secondary);">Amount</span>
                                <span style="font-weight:500;">@(scanResult.Amount?.ToString("N2") ?? "Any")</span>
                            </div>
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span style="color:var(--text-secondary);">Status</span>
                                <span class="badge @GetStatusBadgeClass(scanResult.Status)">@scanResult.Status</span>
                            </div>
                        </div>

                        @if (scanResult.QrCodeId.HasValue && scanResult.Status != "Paid" && scanResult.Status != "Expired")
                        {
                            <button class="btn btn-success" style="margin-top:16px; width:100%;" @onclick="HandlePay" disabled="@paying">
                                @(paying ? "Processing..." : "Pay Now")
                            </button>
                        }
                    }
                </div>
            }
        </div>
    </div>

    <div class="card" style="margin-top:24px;">
        <div class="card-header">QR History</div>
        @if (loadingHistory)
        {
            <div style="text-align:center; padding:32px; color:var(--text-secondary);">Loading...</div>
        }
        else if (qrHistory.Count == 0)
        {
            <div style="text-align:center; padding:32px; color:var(--text-secondary);">No QR codes generated yet.</div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Expires</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var qr in qrHistory)
                    {
                        <tr>
                            <td style="font-family:monospace; font-size:12px; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@qr.Code</td>
                            <td>@qr.Type</td>
                            <td>@(qr.Amount?.ToString("N2") ?? "-")</td>
                            <td><span class="badge @GetStatusBadgeClass(qr.Status)">@qr.Status</span></td>
                            <td>@qr.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>@(qr.ExpiresAt?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private string generateType = "CustomerPay";
    private decimal? generateAmount;
    private string generateDescription = string.Empty;
    private bool generating;
    private QrCodeDto? generatedQr;

    private string scanInput = string.Empty;
    private bool scanning;
    private QrScanResult? scanResult;

    private bool paying;

    private List<QrCodeDto> qrHistory = new();
    private bool loadingHistory;

    private string alertMessage = string.Empty;
    private bool alertSuccess = true;

    private bool _shouldRedirect = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Auth.InitializeAsync();
        }
        catch (InvalidOperationException) { }
        if (!Auth.IsLoggedIn)
        {
            _shouldRedirect = true;
            return;
        }
        Api.SetToken(Auth.Token);
        await LoadHistory();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _shouldRedirect)
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task LoadHistory()
    {
        loadingHistory = true;
        try
        {
            qrHistory = await Api.GetMyQrCodesAsync() ?? new();
        }
        catch (Exception ex)
        {
            ShowAlert($"Failed to load QR history: {ex.Message}", false);
        }
        loadingHistory = false;
    }

    private async Task HandleGenerate()
    {
        generating = true;
        try
        {
            generatedQr = await Api.GenerateQrAsync(generateType, generateAmount, generateDescription);
            ShowAlert("QR code generated.", true);
            await LoadHistory();
        }
        catch (Exception ex)
        {
            ShowAlert($"Failed to generate QR: {ex.Message}", false);
        }
        generating = false;
    }

    private async Task CopyQrCode()
    {
        if (generatedQr != null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", generatedQr.Code);
            ShowAlert("QR code copied to clipboard.", true);
        }
    }

    private void ClearGenerated()
    {
        generatedQr = null;
        generateAmount = null;
        generateDescription = string.Empty;
    }

    private async Task HandleScan()
    {
        scanning = true;
        try
        {
            scanResult = await Api.ScanQrAsync(scanInput);
            if (!scanResult.IsValid)
            {
                ShowAlert(scanResult.Message, false);
            }
        }
        catch (Exception ex)
        {
            ShowAlert($"Failed to scan QR: {ex.Message}", false);
            scanResult = null;
        }
        scanning = false;
    }

    private async Task HandlePay()
    {
        if (scanResult?.QrCodeId == null) return;

        paying = true;
        try
        {
            await Api.PayQrAsync(scanResult.QrCodeId.Value);
            ShowAlert("Payment successful.", true);
            scanResult.Status = "Paid";
            await LoadHistory();
        }
        catch (Exception ex)
        {
            ShowAlert($"Payment failed: {ex.Message}", false);
        }
        paying = false;
    }

    private void ShowAlert(string message, bool success)
    {
        alertMessage = message;
        alertSuccess = success;
        StateHasChanged();
    }

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Active" => "badge-success",
        "Paid" => "badge-success",
        "Pending" => "badge-warning",
        "Expired" => "badge-danger",
        "Invalid" => "badge-danger",
        _ => ""
    };
}