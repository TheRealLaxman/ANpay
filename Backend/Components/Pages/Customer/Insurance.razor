@namespace ANpay.Api.Components.Pages.Customer
@page "/customer/insurance"
@using ANpay.Api.Models
@using ANpay.Api.Components.Services
@inject ApiService ApiService
@inject AuthState AuthState
@rendermode InteractiveServer

<PageTitle>Insurance - ANpay</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-shield-check me-2"></i>Insurance</h2>
            <p class="text-muted">Protect yourself with our micro-insurance products.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-heart-pulse display-4 text-danger"></i>
                    <h5 class="mt-3">Health Insurance</h5>
                    <p class="text-muted">Coverage for medical expenses</p>
                    <div class="fw-bold">From ₦5,000/mo</div>
                    <button class="btn btn-outline-danger mt-2" @onclick="BuyHealth">Get Plan</button>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-phone display-4 text-primary"></i>
                    <h5 class="mt-3">Device Insurance</h5>
                    <p class="text-muted">Protect your device</p>
                    <div class="fw-bold">From ₦2,000/mo</div>
                    <button class="btn btn-outline-primary mt-2" @onclick="BuyDevice">Get Plan</button>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-airplane display-4 text-info"></i>
                    <h5 class="mt-3">Travel Insurance</h5>
                    <p class="text-muted">Coverage while traveling</p>
                    <div class="fw-bold">From ₦3,000/trip</div>
                    <button class="btn btn-outline-info mt-2" @onclick="BuyTravel">Get Plan</button>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="bi bi-building display-4 text-warning"></i>
                    <h5 class="mt-3">Property Insurance</h5>
                    <p class="text-muted">Protect your property</p>
                    <div class="fw-bold">From ₦10,000/mo</div>
                    <button class="btn btn-outline-warning mt-2" @onclick="BuyProperty">Get Plan</button>
                </div>
            </div>
        </div>
    </div>

    @if (insurances != null && insurances.Any())
    {
        <h4 class="mb-3">My Policies</h4>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Policy #</th>
                        <th>Plan</th>
                        <th>Type</th>
                        <th>Premium</th>
                        <th>Coverage</th>
                        <th>Expiry</th>
                        <th>Status</th>
                        <th>Claims</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ins in insurances)
                    {
                        <tr>
                            <td><code>@ins.PolicyNumber</code></td>
                            <td>@ins.PlanName</td>
                            <td>@ins.Type</td>
                            <td>₦@ins.PremiumAmount.ToString("N2")</td>
                            <td>₦@ins.CoverageAmount.ToString("N2")</td>
                            <td>@ins.EndDate.ToString("MMM dd, yyyy")</td>
                            <td><span class="badge @(ins.Status == InsuranceStatus.Active ? "bg-success" : "bg-secondary")">@ins.Status</span></td>
                            <td>@ins.TotalClaims</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<ANpay.Api.Models.Insurance>? insurances;
    private List<WalletDto>? wallets;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn) return;
        insurances = await ApiService.GetAsync<List<ANpay.Api.Models.Insurance>>("/api/insurance");
        wallets = await ApiService.GetAsync<List<WalletDto>>("/api/wallet");
    }

    private async Task PurchaseInsurance(ANpay.Api.Models.InsuranceType type, string planName, decimal premium, decimal coverage)
    {
        if (wallets == null || !wallets.Any()) return;
        var walletId = wallets.First().Id;
        try
        {
            await ApiService.PostAsync<ANpay.Api.Models.Insurance>("/api/insurance/purchase", new
            {
                WalletId = walletId,
                Type = type,
                PlanName = planName,
                PremiumAmount = premium,
                CoverageAmount = coverage,
                Frequency = ANpay.Api.Models.InsuranceFrequency.Monthly,
                DurationMonths = 12
            });
            insurances = await ApiService.GetAsync<List<ANpay.Api.Models.Insurance>>("/api/insurance");
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
    }

    private Task BuyHealth() => PurchaseInsurance(ANpay.Api.Models.InsuranceType.Health, "Health Shield", 5000, 500000);
    private Task BuyDevice() => PurchaseInsurance(ANpay.Api.Models.InsuranceType.Device, "Device Guard", 2000, 200000);
    private Task BuyTravel() => PurchaseInsurance(ANpay.Api.Models.InsuranceType.Travel, "Travel Safe", 3000, 1000000);
    private Task BuyProperty() => PurchaseInsurance(ANpay.Api.Models.InsuranceType.Property, "Property Shield", 10000, 5000000);
}
