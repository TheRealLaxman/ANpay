@page "/customer/investments"
@using ANpay.Api.Models
@using ANpay.Api.Components.Services
@inject ApiService ApiService
@inject AuthState AuthState
@rendermode InteractiveServer

<PageTitle>Investments - ANpay</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-graph-up me-2"></i>Investments & Savings</h2>
            <p class="text-muted">Grow your money with our investment products.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@error</div>
    }

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>
    }
    else
    {
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "investments" ? "active" : "")" @onclick='() => activeTab = "investments"'>Investments</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "savings" ? "active" : "")" @onclick='() => activeTab = "savings"'>Savings Goals</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "products" ? "active" : "")" @onclick='() => activeTab = "products"'>Investment Products</button>
        </li>
    </ul>

    @if (activeTab == "products")
    {
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-success">
                    <div class="card-body">
                        <h5 class="card-title text-success"><i class="bi bi-piggy-bank me-2"></i>Fixed Deposit</h5>
                        <p class="card-text">Lock your funds for a fixed period and earn guaranteed interest.</p>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-check-circle text-success me-2"></i>Up to 15% p.a.</li>
                            <li><i class="bi bi-check-circle text-success me-2"></i>Minimum ₦50,000</li>
                            <li><i class="bi bi-check-circle text-success me-2"></i>30-365 days tenure</li>
                        </ul>
                        <button class="btn btn-success w-100" @onclick="@(() => ShowInvestModal("Fixed Deposit", 15, 50000))">Invest Now</button>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-primary">
                    <div class="card-body">
                        <h5 class="card-title text-primary"><i class="bi bi-bullseye me-2"></i>Savings Goal</h5>
                        <p class="card-text">Set a target and auto-save towards your goals.</p>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-check-circle text-primary me-2"></i>Custom targets</li>
                            <li><i class="bi bi-check-circle text-primary me-2"></i>Auto-save feature</li>
                            <li><i class="bi bi-check-circle text-primary me-2"></i>Visual progress tracking</li>
                        </ul>
                        <button class="btn btn-primary w-100" @onclick="ShowGoalModal">Set Goal</button>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-info">
                    <div class="card-body">
                        <h5 class="card-title text-info"><i class="bi bi-bank me-2"></i>Treasury Bills</h5>
                        <p class="card-text">Invest in government securities for safe returns.</p>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-check-circle text-info me-2"></i>Government backed</li>
                            <li><i class="bi bi-check-circle text-info me-2"></i>8-12% returns</li>
                            <li><i class="bi bi-check-circle text-info me-2"></i>Minimum ₦100,000</li>
                        </ul>
                        <button class="btn btn-info w-100" @onclick='() => ShowInvestModal("Treasury Bill", 10, 100000)'>Invest Now</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (activeTab == "investments")
    {
        @if (investments != null && investments.Any())
        {
            <div class="row">
                @foreach (var inv in investments.Where(i => i.Status == InvestmentStatus.Active))
                {
                    <div class="col-md-6 mb-4">
                        <div class="card">
                            <div class="card-header d-flex justify-content-between">
                                <span>@inv.ProductName</span>
                                <span class="badge bg-success">Active</span>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-6"><small class="text-muted">Invested</small><div class="fw-bold">₦@inv.PrincipalAmount.ToString("N2")</div></div>
                                    <div class="col-6"><small class="text-muted">Current Value</small><div class="fw-bold text-success">₦@inv.CurrentValue.ToString("N2")</div></div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-6"><small class="text-muted">Interest Rate</small><div>@inv.InterestRate% p.a.</div></div>
                                    <div class="col-6"><small class="text-muted">Maturity</small><div>@inv.MaturityDate.ToString("MMM dd, yyyy")</div></div>
                                </div>
                                <div class="mt-3">
                                    <small class="text-muted">Interest Earned: <span class="text-success fw-bold">₦@inv.InterestEarned.ToString("N2")</span></small>
                                </div>
                            </div>
                            <div class="card-footer">
                                <button class="btn btn-outline-danger w-100" @onclick="() => WithdrawInvestment(inv.Id)">
                                    Withdraw @(inv.EarlyWithdrawalPenalty > 0 ? $"(Penalty: ₦{inv.EarlyWithdrawalPenalty:N2})" : "")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card"><div class="card-body text-center py-5"><i class="bi bi-graph-up display-1 text-muted"></i><h4 class="mt-3">No Active Investments</h4><p>Start investing today!</p></div></div>
        }
    }

    @if (activeTab == "savings")
    {
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card border-success">
                    <div class="card-body text-center">
                        <i class="bi bi-plus-circle display-4 text-success"></i>
                        <h5 class="mt-3">New Goal</h5>
                        <button class="btn btn-success mt-2" @onclick="ShowGoalModal">Create Goal</button>
                    </div>
                </div>
            </div>
            @if (savingsGoals != null)
            {
                @foreach (var goal in savingsGoals.Where(g => g.Status == SavingsGoalStatus.Active))
                {
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h5>@goal.GoalName</h5>
                                <div class="progress mb-3" style="height: 20px;">
                                    <div class="progress-bar bg-success" style="width: @goal.ProgressPercentage%">@goal.ProgressPercentage.ToString("N1")%</div>
                                </div>
                                <div class="d-flex justify-content-between"><span>₦@goal.CurrentAmount.ToString("N2")</span><span>₦@goal.TargetAmount.ToString("N2")</span></div>
                                <small class="text-muted d-block mt-2">Target: @goal.TargetDate.ToString("MMM dd, yyyy")</small>
                            </div>
                            <div class="card-footer">
                        <button class="btn btn-outline-success w-100" @onclick="() => ShowContributeModal(goal)">Add Funds</button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    }
</div>

@code {
    private string activeTab = "products";
    private List<Investment>? investments;
    private List<SavingsGoal>? savingsGoals;
    private List<WalletDto>? wallets;
    private bool loading = true;
    private string error = string.Empty;

    // Investment modal state
    private bool showInvestModal;
    private string investProductName = "";
    private decimal investRate;
    private decimal investMinAmount;
    private decimal investAmount;
    private int investTenureDays = 30;
    private Guid investWalletId;

    // Savings goal modal state
    private bool showGoalModal;
    private string goalName = "";
    private decimal goalTargetAmount;
    private DateTime goalTargetDate = DateTime.UtcNow.AddMonths(6);
    private Guid goalWalletId;

    // Contribute modal state
    private bool showContributeModal;
    private SavingsGoal? contributeGoal;
    private decimal contributeAmount;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn) return;
        try
        {
            investments = await ApiService.GetAsync<List<Investment>>("/api/investment");
            savingsGoals = await ApiService.GetAsync<List<SavingsGoal>>("/api/investment/savings-goals");
            wallets = await ApiService.GetAsync<List<WalletDto>>("/api/wallet");
        }
        catch (Exception ex) { error = $"Failed to load data: {ex.Message}"; }
        finally { loading = false; }
    }

    private void ShowInvestModal(string product, decimal rate, decimal min)
    {
        investProductName = product;
        investRate = rate;
        investMinAmount = min;
        investAmount = min;
        investWalletId = wallets?.FirstOrDefault()?.Id ?? Guid.Empty;
        showInvestModal = true;
    }

    private void ShowGoalModal()
    {
        goalName = "";
        goalTargetAmount = 10000;
        goalTargetDate = DateTime.UtcNow.AddMonths(6);
        goalWalletId = wallets?.FirstOrDefault()?.Id ?? Guid.Empty;
        showGoalModal = true;
    }

    private void ShowContributeModal(SavingsGoal goal)
    {
        contributeGoal = goal;
        contributeAmount = goal.AutoSaveAmount > 0 ? goal.AutoSaveAmount : 1000;
        showContributeModal = true;
    }

    private async Task SubmitInvestment()
    {
        try
        {
            showInvestModal = false;
            await ApiService.PostAsync<Investment>("/api/investment", new
            {
                WalletId = investWalletId,
                ProductName = investProductName,
                PrincipalAmount = investAmount,
                InterestRate = investRate,
                TenureDays = investTenureDays
            });
            investments = await ApiService.GetAsync<List<Investment>>("/api/investment");
        }
        catch (Exception ex) { error = $"Investment failed: {ex.Message}"; }
    }

    private async Task SubmitGoal()
    {
        try
        {
            showGoalModal = false;
            await ApiService.PostAsync<SavingsGoal>("/api/investment/savings-goal", new
            {
                WalletId = goalWalletId,
                GoalName = goalName,
                TargetAmount = goalTargetAmount,
                TargetDate = goalTargetDate
            });
            savingsGoals = await ApiService.GetAsync<List<SavingsGoal>>("/api/investment/savings-goals");
        }
        catch (Exception ex) { error = $"Failed to create goal: {ex.Message}"; }
    }

    private async Task SubmitContribution()
    {
        if (contributeGoal == null) return;
        try
        {
            showContributeModal = false;
            await ApiService.PostAsync<object>($"/api/investment/savings-goal/{contributeGoal.Id}/contribute", new { Amount = contributeAmount });
            savingsGoals = await ApiService.GetAsync<List<SavingsGoal>>("/api/investment/savings-goals");
        }
        catch (Exception ex) { error = $"Contribution failed: {ex.Message}"; }
    }

    private async Task WithdrawInvestment(Guid id)
    {
        if (wallets == null || !wallets.Any()) return;
        try
        {
            await ApiService.PostAsync<Investment>($"/api/investment/{id}/withdraw", new { WalletId = wallets.First().Id });
            investments = await ApiService.GetAsync<List<Investment>>("/api/investment");
        }
        catch (Exception ex) { error = $"Withdrawal failed: {ex.Message}"; }
    }
}
