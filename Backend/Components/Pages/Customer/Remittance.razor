@namespace ANpay.Api.Components.Pages.Customer
@page "/customer/send-abroad"
@using ANpay.Api.Models
@using ANpay.Api.Components.Services
@inject ApiService ApiService
@inject AuthState AuthState
@rendermode InteractiveServer

<PageTitle>Send Money Abroad - ANpay</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2><i class="bi bi-globe me-2"></i>Send Money Abroad</h2>
            <p class="text-muted">Transfer money internationally with competitive rates.</p>
        </div>
    </div>

    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "send" ? "active" : "")" @onclick='() => activeTab = "send"'>Send Money</button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "history" ? "active" : "")" @onclick='() => activeTab = "history"'>Transfer History</button>
        </li>
    </ul>

    @if (activeTab == "send")
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">From Wallet</label>
                                <select class="form-select" @bind="sendRequest.WalletId">
                                    <option value="">Select Wallet</option>
                                    @if (wallets != null)
                                    {
                                        @foreach (var w in wallets)
                                        {
                                            <option value="@w.Id">@w.WalletName (@w.Currency @w.Balance.ToString("N2"))</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Recipient Name</label>
                                <input type="text" class="form-control" @bind="sendRequest.RecipientName" placeholder="Full name" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Country</label>
                                <select class="form-select" @bind="sendRequest.RecipientCountry">
                                    <option value="">Select Country</option>
                                    @if (countries != null)
                                    {
                                        @foreach (var c in countries)
                                        {
                                            <option value="@c">@c</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Bank Code</label>
                                <input type="text" class="form-control" @bind="sendRequest.RecipientBankCode" placeholder="SWIFT/BIC code" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Account Number</label>
                                <input type="text" class="form-control" @bind="sendRequest.RecipientAccountNumber" placeholder="Account number" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Currency</label>
                                <select class="form-select" @bind="sendRequest.RecipientCurrency">
                                    <option value="USD">USD - US Dollar</option>
                                    <option value="GBP">GBP - British Pound</option>
                                    <option value="EUR">EUR - Euro</option>
                                    <option value="CAD">CAD - Canadian Dollar</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Amount to Send</label>
                                <input type="number" class="form-control" @bind="sendRequest.SendAmount" min="100" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Purpose</label>
                                <select class="form-select" @bind="sendRequest.Purpose">
                                    <option value="0">Family Support</option>
                                    <option value="1">Education</option>
                                    <option value="2">Medical</option>
                                    <option value="3">Business</option>
                                    <option value="4">Investment</option>
                                    <option value="5">Gift</option>
                                </select>
                            </div>
                        </div>

                        @if (sendRequest.SendAmount > 0)
                        {
                            <div class="card bg-light mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between"><span>Send Amount:</span><span>@sendRequest.SendAmount.ToString("N2") NGN</span></div>
                                    <div class="d-flex justify-content-between"><span>Fee:</span><span>₦500.00</span></div>
                                    <hr />
                                    <div class="d-flex justify-content-between fw-bold"><span>Total Debit:</span><span>@((sendRequest.SendAmount + 500).ToString("N2")) NGN</span></div>
                                </div>
                            </div>
                        }

                        <button class="btn btn-primary w-100" @onclick="SendMoney" disabled="@sending">
                            @if (sending) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Send Money
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (activeTab == "history")
    {
        @if (remittances != null && remittances.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Recipient</th>
                            <th>Country</th>
                            <th>Sent</th>
                            <th>Received</th>
                            <th>Rate</th>
                            <th>Status</th>
                            <th>Tracking</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in remittances)
                        {
                            <tr>
                                <td>@r.CreatedAt.ToString("MMM dd")</td>
                                <td>@r.RecipientName</td>
                                <td>@r.RecipientCountry</td>
                                <td>@r.SendAmount.ToString("N2") @r.SendCurrency</td>
                                <td>@r.ReceiveAmount.ToString("N2") @r.RecipientCurrency</td>
                                <td>@r.ExchangeRate</td>
                                <td><span class="badge @(r.Status == RemittanceStatus.Completed ? "bg-success" : "bg-warning")">@r.Status</span></td>
                                <td><code>@r.TrackingNumber</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card"><div class="card-body text-center py-5"><i class="bi bi-globe display-1 text-muted"></i><h4 class="mt-3">No Transfers Yet</h4></div></div>
        }
    }
</div>

@code {
    private string activeTab = "send";
    private List<WalletDto>? wallets;
    private List<string>? countries;
    private List<ANpay.Api.Models.Remittance>? remittances;
    private bool sending = false;
    private SendMoneyModel sendRequest = new() { RecipientCurrency = "USD", Purpose = ANpay.Api.Models.RemittancePurpose.FamilySupport };

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsLoggedIn) return;
        wallets = await ApiService.GetAsync<List<WalletDto>>("/api/wallet");
        countries = await ApiService.GetAsync<List<string>>("/api/remittance/countries");
        remittances = await ApiService.GetAsync<List<ANpay.Api.Models.Remittance>>("/api/remittance");
    }

    private async Task SendMoney()
    {
        if (string.IsNullOrEmpty(sendRequest.WalletId) || string.IsNullOrEmpty(sendRequest.RecipientName)) return;
        sending = true;
        try
        {
            await ApiService.PostAsync<ANpay.Api.Models.Remittance>("/api/remittance/send", new
            {
                WalletId = Guid.Parse(sendRequest.WalletId),
                RecipientName = sendRequest.RecipientName,
                RecipientCountry = sendRequest.RecipientCountry,
                RecipientBankCode = sendRequest.RecipientBankCode,
                RecipientAccountNumber = sendRequest.RecipientAccountNumber,
                RecipientCurrency = sendRequest.RecipientCurrency,
                SendAmount = sendRequest.SendAmount,
                Purpose = sendRequest.Purpose
            });
            activeTab = "history";
            remittances = await ApiService.GetAsync<List<ANpay.Api.Models.Remittance>>("/api/remittance");
        }
        catch (Exception ex) { Console.WriteLine(ex.Message); }
        sending = false;
    }

    private class SendMoneyModel
    {
        public string WalletId { get; set; } = "";
        public string RecipientName { get; set; } = "";
        public string RecipientCountry { get; set; } = "";
        public string RecipientBankCode { get; set; } = "";
        public string RecipientAccountNumber { get; set; } = "";
        public string RecipientCurrency { get; set; } = "USD";
        public decimal SendAmount { get; set; }
        public ANpay.Api.Models.RemittancePurpose Purpose { get; set; } = ANpay.Api.Models.RemittancePurpose.FamilySupport;
    }
}
