@page "/merchant/dashboard"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using ANpay.Api.Components.Services
@using ANpay.Api.Models
@inject ApiService Api
@inject AuthState Auth
@inject NavigationManager Nav
@attribute [Authorize(Roles = "SuperAdmin,MainBranchAdmin,BranchAdmin")]

<div class="page-container">
    <div class="page-header">
        <h1>Merchant Dashboard</h1>
    </div>

    @if (loading)
    {
        <div class="loading-state">Loading merchant data...</div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="card">
            <p style="color: var(--color-error);">@error</p>
            <button class="btn btn-primary" @onclick="LoadData" style="margin-top: 12px;">Retry</button>
        </div>
    }
    else if (merchant == null)
    {
        <div class="empty-state">
            <h3>No Merchant Account</h3>
            <p>You don't have a merchant account yet.</p>
        </div>
    }
    else
    {
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total Revenue</div>
                <div class="stat-value">$@totalRevenue.ToString("N2")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total Payments</div>
                <div class="stat-value">@totalPayments</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Pending Settlement</div>
                <div class="stat-value">$@pendingSettlement.ToString("N2")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Commission Rate</div>
                <div class="stat-value">@(merchant.CommissionRate * 100)%</div>
            </div>
        </div>

        <div class="card" style="margin-top: 24px;">
            <div class="card-header">
                <h3>Recent Payments</h3>
            </div>
            <div class="card-body">
                @if (payments.Any())
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Order Ref</th>
                                <th>Amount</th>
                                <th>Commission</th>
                                <th>Net</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in payments)
                            {
                                <tr>
                                    <td>@p.OrderReference</td>
                                    <td>$@p.Amount.ToString("N2")</td>
                                    <td>$@p.Commission.ToString("N2")</td>
                                    <td>$@p.NetAmount.ToString("N2")</td>
                                    <td><span class="badge badge-@GetStatusClass(p.Status)">@p.Status</span></td>
                                    <td>@p.CreatedAt.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">No payments yet</div>
                }
            </div>
        </div>

        <div class="card" style="margin-top: 24px;">
            <div class="card-header">
                <h3>Settlement History</h3>
            </div>
            <div class="card-body">
                @if (settlements.Any())
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Gross</th>
                                <th>Net</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in settlements)
                            {
                                <tr>
                                    <td>$@s.GrossAmount.ToString("N2")</td>
                                    <td>$@s.NetAmount.ToString("N2")</td>
                                    <td><span class="badge badge-@GetSettlementStatusClass(s.Status)">@s.Status</span></td>
                                    <td>@s.CreatedAt.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-state">No settlements yet</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool loading = true;
    private string error = string.Empty;
    private Merchant? merchant;
    private List<MerchantPayment> payments = new();
    private List<MerchantSettlement> settlements = new();
    private decimal totalRevenue;
    private int totalPayments;
    private decimal pendingSettlement;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Auth.InitializeAsync();
        }
        catch (InvalidOperationException) { }

        Api.SetToken(Auth.Token);
        await LoadData();
    }

    private async Task LoadData()
    {
        loading = true;
        error = string.Empty;
        try
        {
            merchant = await Api.GetAsync<Merchant>("/api/merchant/me");
            payments = await Api.GetAsync<List<MerchantPayment>>("/api/merchant/payments") ?? new();
            settlements = await Api.GetAsync<List<MerchantSettlement>>("/api/merchant/settlements") ?? new();
            totalPayments = payments.Count;
            totalRevenue = payments.Where(p => p.Status == MerchantPaymentStatus.Completed).Sum(p => p.NetAmount);
            pendingSettlement = settlements.Where(s => s.Status == SettlementStatus.Pending).Sum(s => s.NetAmount);
        }
        catch (Exception ex) { error = $"Failed to load merchant data: {ex.Message}"; }
        finally { loading = false; }
    }

    private string GetStatusClass(MerchantPaymentStatus status) => status switch
    {
        MerchantPaymentStatus.Completed => "success",
        MerchantPaymentStatus.Pending => "warning",
        MerchantPaymentStatus.Failed => "danger",
        _ => "info"
    };

    private string GetSettlementStatusClass(SettlementStatus status) => status switch
    {
        SettlementStatus.Completed => "success",
        SettlementStatus.Pending => "warning",
        _ => "info"
    };
}
