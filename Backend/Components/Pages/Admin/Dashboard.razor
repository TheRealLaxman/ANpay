@page "/admin/dashboard"
@rendermode InteractiveServer
@using ANpay.Api.Components.Services
@inject AuthState Auth
@inject ApiService Api
@inject NavigationManager Nav

@if (!isInitialized)
{
    return;
}

@if (!Auth.IsLoggedIn || !Auth.IsSuperAdmin())
{
    return;
}

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1>Admin Dashboard</h1>
            <p>Welcome back, @Auth.GetDisplayName()</p>
        </div>
        <div class="header-right">
            <span class="badge badge-success">Super Admin</span>
            <button class="btn btn-outline" @onclick="Logout">Logout</button>
        </div>
    </div>

    @if (loading)
    {
        <div class="card"><p>Loading dashboard...</p></div>
    }
    else if (stats != null)
    {
        <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
            <div class="stat-card">
                <div class="stat-label">Total Users</div>
                <div class="stat-value">@stats.TotalUsers.ToString("N0")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total Wallets</div>
                <div class="stat-value">@stats.TotalWallets.ToString("N0")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total Balance</div>
                <div class="stat-value">$@stats.TotalBalance.ToString("N2")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Active Branches</div>
                <div class="stat-value">@stats.TotalBranches</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Today Transactions</div>
                <div class="stat-value">@stats.TodayTransactions</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Today Volume</div>
                <div class="stat-value">$@stats.TodayVolume.ToString("N2")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Month Volume</div>
                <div class="stat-value">$@stats.MonthVolume.ToString("N2")</div>
            </div>
            <div class="stat-card @(stats.PendingApprovals > 0 ? "stat-warning" : "")">
                <div class="stat-label">Pending Approvals</div>
                <div class="stat-value">@stats.PendingApprovals</div>
            </div>
            <div class="stat-card @(stats.PendingKyc > 0 ? "stat-warning" : "")">
                <div class="stat-label">Pending KYC</div>
                <div class="stat-value">@stats.PendingKyc</div>
            </div>
            <div class="stat-card @(stats.OpenTickets > 0 ? "stat-warning" : "")">
                <div class="stat-label">Open Tickets</div>
                <div class="stat-value">@stats.OpenTickets</div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <div class="card">
                <h3 style="font-size: 16px; margin-bottom: 16px;">Quick Actions</h3>
                <div class="quick-actions">
                    <a href="/admin/users" class="btn btn-primary">Manage Users</a>
                    <a href="/admin/branches" class="btn btn-primary">Manage Branches</a>
                    <a href="/admin/transactions" class="btn btn-primary">Transactions</a>
                </div>
            </div>

            <div class="card">
                <h3 style="font-size: 16px; margin-bottom: 16px;">System Info</h3>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-secondary);">Platform</span>
                        <span>ANpay Digital Wallet</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-secondary);">Version</span>
                        <span>1.0.0</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-secondary);">Admin Account</span>
                        <span>@Auth.GetDisplayName()</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="card">
            <p style="color: var(--color-error);">@error</p>
            <button class="btn btn-primary" @onclick="LoadStats" style="margin-top: 12px;">Retry</button>
        </div>
    }
</div>

@code {
    private DashboardStatsDto? stats;
    private bool loading = true;
    private string error = string.Empty;
    private bool isInitialized = false;
    private bool _shouldRedirect = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Auth.InitializeAsync();
        }
        catch (InvalidOperationException) { }

        if (!Auth.IsLoggedIn || !Auth.IsSuperAdmin())
        {
            _shouldRedirect = true;
            return;
        }
        Api.SetToken(Auth.Token);
        isInitialized = true;
        await LoadStats();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _shouldRedirect)
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task LoadStats()
    {
        loading = true;
        error = string.Empty;
        try
        {
            stats = await Api.GetDashboardStatsAsync();
        }
        catch (Exception ex)
        {
            error = $"Failed to load dashboard: {ex.Message}";
        }
        loading = false;
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
