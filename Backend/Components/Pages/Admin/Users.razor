@page "/admin/users"
@rendermode InteractiveServer
@using ANpay.Api.Components.Services
@inject AuthState Auth
@inject NavigationManager Nav

@if (!Auth.IsLoggedIn || !Auth.IsSuperAdmin())
{
    Nav.NavigateTo("/login");
    return;
}

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1>User Management</h1>
            <p>Manage all users in the system</p>
        </div>
        <div class="header-right">
            <a href="/admin/dashboard" class="btn btn-outline">Back to Dashboard</a>
        </div>
    </div>

    <div class="card">
        <p style="color: var(--text-secondary); margin-bottom: 16px;">User management APIs are ready. UI coming soon.</p>
        <p style="color: var(--text-secondary); font-size: 14px;">Available APIs:</p>
        <ul style="color: var(--text-secondary); font-size: 14px; margin-left: 20px;">
            <li>GET /api/branch - List all branches</li>
            <li>POST /api/branch - Create branch</li>
            <li>GET /api/employee/branch/{id} - List employees</li>
            <li>POST /api/employee - Create employee</li>
            <li>GET /api/audit - View audit logs</li>
        </ul>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsLoggedIn || !Auth.IsSuperAdmin())
            Nav.NavigateTo("/login");
    }
}
