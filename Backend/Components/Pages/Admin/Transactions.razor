@page "/admin/transactions"
@rendermode InteractiveServer
@using ANpay.Api.Components.Services
@inject ApiService Api
@inject AuthState Auth
@inject NavigationManager Nav

@if (!isInitialized)
{
    return;
}

@if (!Auth.IsLoggedIn || !Auth.IsSuperAdmin())
{
    return;
}

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1>Transaction Overview</h1>
            <p>View and monitor all transactions across the system</p>
        </div>
        <div class="header-right">
            <a href="/admin/dashboard" class="btn btn-outline">Back</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-@(isSuccess ? "success" : "danger")">@message</div>
    }

    <div class="grid grid-4" style="margin-bottom: 24px;">
        <div class="card stat-card">
            <div class="stat-icon green">$</div>
            <div class="card-value">@stats.TotalBalance.ToString("N2")</div>
            <div class="card-header">Total Balance</div>
        </div>
        <div class="card stat-card">
            <div class="stat-icon white">@stats.TodayTransactions</div>
            <div class="card-header">Today Transactions</div>
        </div>
        <div class="card stat-card">
            <div class="stat-icon green">$@stats.TodayVolume.ToString("N2")</div>
            <div class="card-header">Today Volume</div>
        </div>
        <div class="card stat-card">
            <div class="stat-icon red">@stats.PendingApprovals</div>
            <div class="card-header">Pending Approvals</div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Branch Transaction Summary</div>
        <table class="table">
            <thead>
                <tr>
                    <th>Branch</th>
                    <th>Today Deposits</th>
                    <th>Today Withdrawals</th>
                    <th>Today Transfers</th>
                    <th>Cash Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var branch in branchSummaries)
                {
                    <tr>
                        <td>@branch.Name</td>
                        <td>$@branch.TodayDeposits.ToString("N2")</td>
                        <td>$@branch.TodayWithdrawals.ToString("N2")</td>
                        <td>@branch.TodayTransfers</td>
                        <td>$@branch.CashBalance.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!branchSummaries.Any())
        {
            <p style="text-align:center; color: var(--text-secondary); padding: 32px;">No branch data found</p>
        }
    </div>
</div>

@code {
    private bool isInitialized = false;
    private List<BranchSummary> branchSummaries = new();
    private DashboardStatsDto stats = new();
    private string message = string.Empty;
    private bool isSuccess = true;

    private bool _shouldRedirect = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Auth.InitializeAsync();
        }
        catch (InvalidOperationException) { }

        if (!Auth.IsLoggedIn || !Auth.IsSuperAdmin())
        {
            _shouldRedirect = true;
            return;
        }
        isInitialized = true;
        Api.SetToken(Auth.Token);
        await LoadData();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _shouldRedirect)
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task LoadData()
    {
        try
        {
            stats = await Api.GetDashboardStatsAsync();
            var branches = await Api.GetBranchesAsync();
            branchSummaries = new List<BranchSummary>();
            foreach (var branch in branches)
            {
                try
                {
                    var branchDash = await Api.GetBranchDashboardAsync(branch.Id);
                    branchSummaries.Add(new BranchSummary
                    {
                        Name = branch.Name,
                        TodayDeposits = branchDash.TodayDeposits,
                        TodayWithdrawals = branchDash.TodayWithdrawals,
                        TodayTransfers = branchDash.TodayTransfers,
                        CashBalance = branchDash.CashBalance
                    });
                }
                catch { }
            }
        }
        catch (Exception ex) { ShowAlert(ex.Message, "danger"); }
    }

    private void ShowAlert(string msg, string type)
    {
        message = msg;
        isSuccess = type == "success";
    }

    private class BranchSummary
    {
        public string Name { get; set; } = string.Empty;
        public decimal TodayDeposits { get; set; }
        public decimal TodayWithdrawals { get; set; }
        public int TodayTransfers { get; set; }
        public decimal CashBalance { get; set; }
    }
}
