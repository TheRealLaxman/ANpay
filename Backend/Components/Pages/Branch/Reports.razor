@page "/branch/reports"
@rendermode InteractiveServer
@using ANpay.Api.Components.Services
@inject ApiService Api
@inject AuthState Auth
@inject NavigationManager Nav

@if (!Auth.IsLoggedIn || !Auth.IsBranchAdmin())
{
    Nav.NavigateTo("/login");
    return;
}

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1>Branch Reports</h1>
            <p>View reports and analytics for your branch</p>
        </div>
        <div class="header-right">
            <a href="/branch/dashboard" class="btn btn-outline">Back</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-@(isSuccess ? "success" : "danger")">@message</div>
    }

    <div class="grid grid-4" style="margin-bottom: 24px;">
        <div class="card stat-card">
            <div class="stat-icon green">$</div>
            <div class="card-value">@stats.TodayVolume.ToString("N2")</div>
            <div class="card-header">Today Volume</div>
        </div>
        <div class="card stat-card">
            <div class="stat-icon white">@stats.TodayTransactions</div>
            <div class="card-header">Today Transactions</div>
        </div>
        <div class="card stat-card">
            <div class="stat-icon green">@stats.TotalUsers</div>
            <div class="card-header">Total Users</div>
        </div>
        <div class="card stat-card">
            <div class="stat-icon red">@stats.PendingApprovals</div>
            <div class="card-header">Pending Approvals</div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Transaction Summary</div>
        <div class="table-filters">
            <input class="form-control" type="date" @bind="startDate" />
            <input class="form-control" type="date" @bind="endDate" />
            <button class="btn btn-primary" @onclick="LoadData">Filter</button>
        </div>
        <table class="table">
            <thead>
                <tr>
                    <th>Metric</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Total Users</td>
                    <td>@stats.TotalUsers</td>
                </tr>
                <tr>
                    <td>Total Wallets</td>
                    <td>@stats.TotalWallets</td>
                </tr>
                <tr>
                    <td>Total Balance</td>
                    <td>@stats.TotalBalance.ToString("N2")</td>
                </tr>
                <tr>
                    <td>Today Transactions</td>
                    <td>@stats.TodayTransactions</td>
                </tr>
                <tr>
                    <td>Today Volume</td>
                    <td>@stats.TodayVolume.ToString("N2")</td>
                </tr>
                <tr>
                    <td>Month Transactions</td>
                    <td>@stats.MonthTransactions</td>
                </tr>
                <tr>
                    <td>Month Volume</td>
                    <td>@stats.MonthVolume.ToString("N2")</td>
                </tr>
                <tr>
                    <td>Pending Approvals</td>
                    <td>@stats.PendingApprovals</td>
                </tr>
                <tr>
                    <td>Pending KYC</td>
                    <td>@stats.PendingKyc</td>
                </tr>
                <tr>
                    <td>Open Tickets</td>
                    <td>@stats.OpenTickets</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {
    private DashboardStatsDto stats = new();
    private string message = string.Empty;
    private bool isSuccess = true;
    private DateTime startDate = DateTime.Today.AddDays(-30);
    private DateTime endDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsLoggedIn || !Auth.IsBranchAdmin())
        {
            Nav.NavigateTo("/login");
            return;
        }
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            stats = await Api.GetDashboardStatsAsync();
        }
        catch (Exception ex) { ShowAlert(ex.Message, "danger"); }
    }

    private void ShowAlert(string msg, string type) { message = msg; isSuccess = type == "success"; }
}
