@page "/branch/officials"
@rendermode InteractiveServer
@using ANpay.Api.Components.Services
@inject AuthState Auth
@inject NavigationManager Nav

@if (!Auth.IsLoggedIn || !Auth.IsBranchAdmin())
{
    Nav.NavigateTo("/login");
    return;
}

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1>Employee Management</h1>
            <p>Manage officials in your branch</p>
        </div>
        <div class="header-right">
            <a href="/branch/dashboard" class="btn btn-outline">Back</a>
        </div>
    </div>

    <div class="card">
        <p style="color: var(--text-secondary);">Employee management APIs are ready.</p>
        <p style="color: var(--text-secondary); font-size: 14px; margin-top: 8px;">Available APIs:</p>
        <ul style="color: var(--text-secondary); font-size: 14px; margin-left: 20px;">
            <li>GET /api/employee/branch/{branchId}</li>
            <li>POST /api/employee - Create employee</li>
            <li>PUT /api/employee/{id}/subrole - Update sub-role</li>
            <li>DELETE /api/employee/{id} - Deactivate</li>
        </ul>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsLoggedIn || !Auth.IsBranchAdmin())
            Nav.NavigateTo("/login");
    }
}
