@page "/branch/dashboard"
@rendermode InteractiveServer
@using ANpay.Api.Components.Services
@inject AuthState Auth
@inject ApiService Api
@inject NavigationManager Nav

@if (!isInitialized)
{
    return;
}

@if (!Auth.IsLoggedIn || !Auth.IsBranchAdmin())
{
    return;
}

<div class="page-container">
    <div class="page-header">
        <div class="header-left">
            <h1>Branch Dashboard</h1>
            <p>Welcome, @Auth.GetDisplayName()</p>
        </div>
        <div class="header-right">
            <span class="badge badge-info">Branch Admin</span>
            <button class="btn btn-outline" @onclick="Logout">Logout</button>
        </div>
    </div>

    @if (loading)
    {
        <div class="card"><p>Loading dashboard...</p></div>
    }
    else if (branchStats != null)
    {
        <div class="stats-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
            <div class="stat-card">
                <div class="stat-label">Employees</div>
                <div class="stat-value">@branchStats.EmployeeCount</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Today Deposits</div>
                <div class="stat-value">$@branchStats.TodayDeposits.ToString("N2")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Today Withdrawals</div>
                <div class="stat-value">$@branchStats.TodayWithdrawals.ToString("N2")</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Today Transfers</div>
                <div class="stat-value">@branchStats.TodayTransfers</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Cash Balance</div>
                <div class="stat-value">$@branchStats.CashBalance.ToString("N2")</div>
            </div>
            <div class="stat-card @(branchStats.PendingApprovals > 0 ? "stat-warning" : "")">
                <div class="stat-label">Pending Approvals</div>
                <div class="stat-value">@branchStats.PendingApprovals</div>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <div class="card">
                <h3 style="font-size: 16px; margin-bottom: 16px;">Quick Actions</h3>
                <div class="quick-actions">
                    <a href="/branch/officials" class="btn btn-primary">Manage Employees</a>
                    <a href="/branch/reports" class="btn btn-primary">View Reports</a>
                </div>
            </div>

            <div class="card">
                <h3 style="font-size: 16px; margin-bottom: 16px;">Branch Info</h3>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-secondary);">Branch</span>
                        <span>@branchStats.BranchName</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: var(--text-secondary);">Status</span>
                        <span class="badge badge-success">@branchStats.Status</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="card">
            <p style="color: var(--color-error);">@error</p>
            <button class="btn btn-primary" @onclick="LoadDashboard" style="margin-top: 12px;">Retry</button>
        </div>
    }
</div>

@code {
    private BranchDashboardDto? branchStats;
    private bool loading = true;
    private string error = string.Empty;
    private bool isInitialized = false;

    private bool _shouldRedirect = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Auth.InitializeAsync();
        }
        catch (InvalidOperationException) { }

        if (!Auth.IsLoggedIn || !Auth.IsBranchAdmin())
        {
            _shouldRedirect = true;
            return;
        }
        Api.SetToken(Auth.Token);
        isInitialized = true;
        await LoadDashboard();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _shouldRedirect)
        {
            Nav.NavigateTo("/login");
        }
    }

    private async Task LoadDashboard()
    {
        loading = true;
        error = string.Empty;
        try
        {
            // TODO: Get the actual branch ID from the user's claims/profile
            // For now, the API should return the branch based on the authenticated user
            branchStats = await Api.GetMyBranchDashboardAsync();
        }
        catch (Exception ex)
        {
            error = $"Failed to load dashboard: {ex.Message}";
        }
        loading = false;
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
