@page "/forgot-password"
@rendermode InteractiveServer
@using ANpay.Api.Components.Services
@inject ApiService Api
@inject NavigationManager Nav

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-logo">
            AN<span>pay</span>
        </div>
        <h2 class="auth-title">Reset your password</h2>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert alert-@(isSuccess ? "success" : "danger")">@message</div>
        }

        @if (!showResetForm)
        {
            <p style="color:var(--text-secondary); font-size:14px; margin-bottom:16px;">
                Enter your email address and we'll send you a password reset link.
            </p>
            <EditForm Model="emailModel" OnValidSubmit="HandleForgotPassword">
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" @bind="emailModel.Email" placeholder="Enter your email" required />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%;" disabled="@isLoading">
                    @(isLoading ? "Sending..." : "Send Reset Link")
                </button>
            </EditForm>
        }
        else
        {
            <p style="color:var(--text-secondary); font-size:14px; margin-bottom:16px;">
                Enter the reset token from your email and your new password.
            </p>
            <EditForm Model="resetModel" OnValidSubmit="HandleResetPassword">
                <div class="form-group">
                    <label class="form-label">Reset Token</label>
                    <input type="text" class="form-control" @bind="resetModel.Token" placeholder="Paste reset token" required />
                </div>
                <div class="form-group">
                    <label class="form-label">New Password</label>
                    <input type="password" class="form-control" @bind="resetModel.NewPassword" placeholder="Enter new password" required />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%;" disabled="@isLoading">
                    @(isLoading ? "Resetting..." : "Reset Password")
                </button>
            </EditForm>
        }

        <p style="text-align:center; margin-top:20px; color:var(--text-secondary);">
            <a href="/login" class="auth-link">Back to Sign In</a>
        </p>
    </div>
</div>

@code {
    private EmailModel emailModel = new();
    private ResetModel resetModel = new();
    private string message = string.Empty;
    private bool isSuccess = true;
    private bool isLoading = false;
    private bool showResetForm = false;

    private async Task HandleForgotPassword()
    {
        isLoading = true;
        message = string.Empty;
        try
        {
            await Api.ForgotPasswordAsync(emailModel.Email);
            message = "If the email exists, a reset link has been sent. Check your email for the token.";
            isSuccess = true;
            showResetForm = true;
        }
        catch (Exception ex)
        {
            message = $"Failed: {ex.Message}";
            isSuccess = false;
        }
        isLoading = false;
    }

    private async Task HandleResetPassword()
    {
        if (string.IsNullOrWhiteSpace(resetModel.Token) || string.IsNullOrWhiteSpace(resetModel.NewPassword))
        {
            message = "Please fill in all fields.";
            isSuccess = false;
            return;
        }
        isLoading = true;
        message = string.Empty;
        try
        {
            await Api.ForgotPasswordAsync(emailModel.Email);
            message = "Password reset successfully! You can now sign in.";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            message = $"Failed: {ex.Message}";
            isSuccess = false;
        }
        isLoading = false;
    }

    private class EmailModel { public string Email { get; set; } = string.Empty; }
    private class ResetModel { public string Token { get; set; } = string.Empty; public string NewPassword { get; set; } = string.Empty; }
}
