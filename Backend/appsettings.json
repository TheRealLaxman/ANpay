{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppUrl": "http://localhost:5069",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ANpayDB;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": ""
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_RANDOM_64_CHAR_STRING_USE_DOTNET_USER_SECRETS_OR_ENV_VARS",
    "Issuer": "ANpay",
    "Audience": "ANpayApp",
    "ExpirationInMinutes": 15,
    "RefreshTokenExpirationInDays": 7
  },
  "AdminSettings": {
    "InitialPassword": "REPLACE_WITH_STRONG_PASSWORD_USE_USER_SECRETS"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "ANpay",
    "EnableSsl": true
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "FromNumber": ""
  },
  "RateLimiting": {
    "MaxRequestsPerMinute": 60,
    "CleanupIntervalSeconds": 30
  },
  "AccountLockout": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 15
  },
  "DataProtection": {
    "ApplicationName": "ANpay"
  },
  "PaymentGateway": {
    "Provider": "Stripe",
    "PublicKey": "pk_test_your_stripe_public_key",
    "SecretKey": "sk_test_your_stripe_secret_key",
    "WebhookSecret": "whsec_your_webhook_secret"
  },
  "Crypto": {
    "BitcoinRpcUrl": "http://localhost:8332",
    "BitcoinRpcUser": "rpc_user",
    "BitcoinRpcPassword": "rpc_password",
    "EthereumRpcUrl": "https://mainnet.infura.io/v3/YOUR_INFURA_KEY",
    "TronApiKey": "your-tron-api-key"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5069",
      "https://your-production-domain.com"
    ]
  }
